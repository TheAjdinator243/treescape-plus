# ─────────────────────────────────────────────────────────────
#  TreeScape — varijable okruženja
#  Kopiraj ovu datoteku u `.env.local` i popuni prave vrijednosti.
#  `.env.local` se NIKADA ne commita na GitHub.
# ─────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tvoj-projekat.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Service role ključ — SAMO server. Nikada ga ne stavljaj u NEXT_PUBLIC_ varijablu.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Plaćanje ────────────────────────────────────────────────
# Bankovni podaci (IBAN, naziv primaoca) se NE drže ovdje nego u
# administraciji: /admin → Cijene → "Podaci za uplatu na račun".
# Tako ih vlasnik mijenja sam, bez diranja koda i bez ponovne objave.
#
# TEST način plaćanja: potvrđuje rezervaciju bez ijednog pravog centa.
# Služi da se cijeli tok isproba. NIKADA ga ne ostavljaj na "true" na
# pravom sajtu — svako bi mogao rezervisati besplatno.
ENABLE_TEST_PAYMENTS=false

# ── Admin pristup ───────────────────────────────────────────
# Tajni kod kojim vlasnik otključava /admin.
#
# Ovaj jedan kod je JEDINA brava između interneta i imena, mailova i telefona
# svih gostiju. Kraći od 12 znakova se NE PRIHVATA — prijava se odbija dok se
# ne produži. Ne izmišljaj ga sam, generiši: openssl rand -base64 24
ADMIN_ACCESS_CODE=promijeni-me-u-dug-nasumican-kod
# Tajna za potpisivanje admin kolačića. Generiši: openssl rand -base64 32
ADMIN_SESSION_SECRET=promijeni-me-najmanje-32-znaka-duga-tajna

# Drugi faktor — šestocifreni kod iz aplikacije na telefonu (TOTP).
#
# Dok je prazno, prijava traži samo pristupni kod. Čim se postavi, traži i
# kod s telefona, a sve otvorene sesije prestaju vrijediti.
#
# NE upisuj ovo ručno — pokreni `npm run totp`. Ta skripta napravi tajnu,
# pokaže je u obliku koji aplikacija razumije i PROVJERI da se poklapa prije
# nego išta ode na pravi sajt.
#
# Izgubljen telefon: obriši ovu varijablu i pokreni Redeploy — prijava se
# vraća na sam pristupni kod. Zato pristup hosting nalogu čuvaj barem koliko
# i sam kod.
ADMIN_TOTP_SECRET=

# ── Cron ────────────────────────────────────────────────────
# Štiti /api/cron/expire-holds. Generiši: openssl rand -hex 32
#
# OBAVEZAN. Bez njega se ruta ne izvršava nego vraća 401 — ranije je bila
# otvorena svima dok varijabla nije postavljena. Zaključana ruta ne lomi
# ništa: istekle termine oslobađa i svako čitanje dostupnosti.
CRON_SECRET=promijeni-me

# ── Aplikacija ──────────────────────────────────────────────
# Puni URL sajta, bez kose crte na kraju. Lokalno: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Email (opcionalno) ──────────────────────────────────────
# Ako sve ostaviš prazno, aplikacija radi normalno — samo ne šalje mailove.
#
# Vlasnikova adresa — tu stižu obavijesti o novim rezervacijama.
OWNER_EMAIL=vlasnik@primjer.ba
#
# Postoje DVA načina slanja. Dovoljan je jedan. Ako su podešena oba,
# prednost ima Gmail.

# ── Način 1: Gmail (najlakši, ne traži vlastiti domen) ──────
# Šalje s tvoje Google adrese, bilo kome, odmah.
#
# GMAIL_APP_PASSWORD NIJE lozinka kojom se prijavljuješ na Google.
# To je zasebna "lozinka za aplikacije" od 16 znakova:
#   1) Uključi dvostruku provjeru na Google nalogu (bez nje se ne može)
#   2) myaccount.google.com → Security → App passwords → napravi novu
#   3) Prepiši 16 znakova ovdje (razmaci nisu bitni)
# Može se poništiti kad god, bez diranja same lozinke naloga.
GMAIL_USER=tvoja.adresa@gmail.com
GMAIL_APP_PASSWORD=

# ── Način 2: Resend (kad kuća dobije svoj domen) ────────────
# Mailovi tada idu s rezervacije@tvoj-domen.ba umjesto s Gmail adrese.
# Dok domen nije potvrđen u Resend-u, moguće je pisati SAMO adresi s
# kojom je nalog otvoren — pravom gostu ne prolazi.
RESEND_API_KEY=
EMAIL_FROM=TreeScape <rezervacije@tvoj-domen.ba>

# ── Telegram (opcionalno, ali preporučeno) ──────────────────
# Obavijest o novom zahtjevu koja stigne na telefon za koju sekundu.
# Zahtjev za gotovinu drži termin samo neko vrijeme, pa je bitno da
# vlasnik sazna odmah — mail zna kasniti i završiti u promocijama.
#
# Kako se dobiju ove dvije vrijednosti (traje 2 minute, besplatno je):
#   1) U Telegramu potraži @BotFather → /newbot → dobiješ TOKEN
#   2) Napiši svom novom botu bilo šta (npr. "zdravo") — dok mu ne
#      napišeš prvi, bot ti ne smije slati poruke
#   3) Otvori: https://api.telegram.org/bot<TOKEN>/getUpdates
#      i prepiši broj iz "chat":{"id": ... }
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
