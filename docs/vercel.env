# ═══════════════════════════════════════════════════════════════════════════
#  TreeScape — varijable okruženja
# ═══════════════════════════════════════════════════════════════════════════
#
#  KAKO SE OVO UNOSI NA VERCEL
#  Vercel → tvoj projekat → Settings → Environment Variables.
#  Gore desno ima dugme "Import .env" — možeš prevući cijeli ovaj fajl umjesto
#  da lijepiš jednu po jednu. Za svaku varijablu označi za koja okruženja važi:
#  Production, Preview i Development. Ako nisi siguran — označi sva tri.
#
#  VAŽNO: nakon izmjene bilo koje varijable moraš napraviti NOVI DEPLOY.
#  Vercel ne primjenjuje promjene na već objavljenu verziju.
#  (Deployments → tri tačke pored zadnjeg → Redeploy)
#
#  ZA LOKALNI RAD: kopiraj ovaj fajl u `.env.local` u korijenu projekta.
#  `.env.local` je u .gitignore i ne završava na GitHubu.
#
#  ŠTA JE OBAVEZNO: ništa. Sajt se podiže i bez ijednog ključa — radi na demo
#  podacima da možeš vidjeti kako izgleda. Ali BEZ BAZE se rezervacije NE
#  PAMTE. Za pravi rad ti trebaju grupe 1, 2 i 3.
#
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────
#  1. BAZA PODATAKA — Supabase
# ───────────────────────────────────────────────────────────────────────────
#
#  Bez ovoga sajt radi na izmišljenim podacima: kalendar pokazuje slobodne
#  termine kojih nema, a rezervacija koju gost pošalje nestaje pri prvom
#  restartu. Ovo je jedina grupa bez koje sajt nije stvaran.
#
#  GDJE SE NALAZI:
#  supabase.com → uloguj se → izaberi svoj projekat → u lijevom meniju na dnu
#  ikonica zupčanika (Project Settings) → API
#
#  Na toj stranici vidiš tri stvari koje ti trebaju:
#
#    "Project URL"                    → NEXT_PUBLIC_SUPABASE_URL
#    "Project API keys" → anon public → NEXT_PUBLIC_SUPABASE_ANON_KEY
#    "Project API keys" → service_role → SUPABASE_SERVICE_ROLE_KEY
#
#  (U novijoj verziji Supabase konzole ista stranica se zove
#   Project Settings → API Keys, a ključevi mogu pisati kao
#   "publishable" umjesto anon i "secret" umjesto service_role.)

# Adresa tvog Supabase projekta. Izgleda ovako: https://abcdefgh.supabase.co
# NEXT_PUBLIC_ znači da je vidljiva u pregledniku — i to je u redu, ovo nije
# tajna. Bez nje preglednik ne zna kome da se javi za slobodne termine.
NEXT_PUBLIC_SUPABASE_URL=

# Javni ključ. Dugačak niz koji počinje sa "eyJ...". Također nije tajna — on
# sam po sebi ne može ništa jer je nad tabelama uključen RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

#  ⚠️  OVO JE PRAVA TAJNA — NIKAD JE NE ŠALJI NIKOME I NE STAVLJAJ NA GITHUB
#
#  service_role ključ zaobilazi SVU zaštitu baze. Ko ga ima, može pročitati i
#  obrisati svaku rezervaciju sa svakim imenom, brojem telefona i mejlom.
#  Koristi se samo na serveru, nikad u pregledniku — zato NEMA prefiks
#  NEXT_PUBLIC_, i taj prefiks mu se NIKAD ne smije dodati.
#
#  U Supabase konzoli je sakriven iza dugmeta "Reveal". Ako ga ikad slučajno
#  pošalješ nekome ili objaviš, odmah idi na istu stranicu i klikni
#  "Generate new secret" / "Roll key" — stari prestaje vrijediti.
SUPABASE_SERVICE_ROLE_KEY=

#  PRIJE PRVOG KORIŠTENJA moraš napraviti tabele:
#  Supabase → SQL Editor → New query → zalijepi sadržaj fajla iz
#  `supabase/migrations/` (redom, ako ih ima više) → Run.
#  Provjera da je prošlo: `npm run db:check`


# ───────────────────────────────────────────────────────────────────────────
#  2. ADRESA SAJTA
# ───────────────────────────────────────────────────────────────────────────
#
#  Ovo je jedini podatak koji, kad je pogrešan, NE POKVARI NIŠTA NA SAJTU —
#  nego tek u gostovom pretincu. Sve radi, mail stigne, a dugme u mailu vodi
#  na Vercelovu stranicu "DEPLOYMENT_NOT_FOUND". Otkrije se tek kad gost
#  klikne, dakle kad je najgore.
#
#  GDJE SE NALAZI:
#  Vercel → projekat → Settings → Domains. Uzmi onaj domen koji je označen
#  kao Production, ne onaj s nasumičnim slovima.
#
#  Piše se BEZ kose crte na kraju:  https://treescape.ba
#  NE ovako:                        https://treescape.ba/
#
#  Možeš je i ostaviti praznu — tada aplikacija sama uzme produkcijski domen
#  koji Vercel prijavljuje o sebi. Popuni je tek kad imaš svoj domen.
NEXT_PUBLIC_SITE_URL=


# ───────────────────────────────────────────────────────────────────────────
#  3. ADMINISTRACIJA — pristup panelu
# ───────────────────────────────────────────────────────────────────────────
#
#  Bez ove dvije varijable panel NIKOGA ne pušta unutra i to je namjerno:
#  bolje da si ti zaključan vani, nego da je spisak gostiju otvoren svima.
#
#  GDJE SE NALAZI: nigdje — ovo ti sam izmišljaš.

# Kod kojim se ulaziš u panel. Ti ga biraš. Neka bude DUG — ovo je jedino što
# stoji između interneta i imena, brojeva telefona i mejlova tvojih gostiju.
# Preporuka: najmanje 20 znakova, bez riječi iz rječnika.
# Možeš ga generisati u terminalu:  openssl rand -base64 24
ADMIN_ACCESS_CODE=

# Tajna kojom se potpisuje kolačić sesije. Također je ti izmišljaš, najmanje
# 32 znaka. NIJE isto što i kod gore i ne smije biti isti.
# Generiši:  openssl rand -base64 48
# Ako je promijeniš, svi koji su prijavljeni bivaju odjavljeni — to je ujedno
# i način da nekoga izbaciš van.
ADMIN_SESSION_SECRET=

# Drugi faktor — šestocifreni kod iz aplikacije na telefonu (Google
# Authenticator, Authy, 1Password…). OPCIONALNO ali toplo preporučeno.
#
# Dok je prazno, prijava traži samo kod odozgo. Čim ovo postaviš, traži i broj
# s telefona, a sve ranije otvorene sesije prestaju vrijediti.
#
# GDJE SE NALAZI: pravi se ovdje, u terminalu:
#   npm run totp
# Ispisaće ti QR kod koji skeniraš telefonom i tajnu koju upišeš ovdje.
ADMIN_TOTP_SECRET=


# ───────────────────────────────────────────────────────────────────────────
#  4. AUTOMATSKO OSLOBAĐANJE TERMINA (cron)
# ───────────────────────────────────────────────────────────────────────────
#
#  Kad gost pošalje zahtjev, termin se drži za njega neko vrijeme (podešava se
#  u panelu). Ako se ne potvrdi, mora se osloboditi. To radi Vercel Cron svaki
#  dan u 03:00 UTC — vidi `vercel.json`.
#
#  BEZ OVE TAJNE CRON RUTA JE ZAKLJUČANA. To ništa ne lomi (termini se
#  oslobađaju i pri svakom čitanju kalendara), ali je bolje da radi.
#
#  GDJE SE NALAZI: ti je izmišljaš.  openssl rand -base64 32
#  Vercel je sam šalje kao `Authorization: Bearer <CRON_SECRET>` — ne moraš
#  nigdje ništa dodatno podešavati, samo je upiši ovdje.
CRON_SECRET=


# ───────────────────────────────────────────────────────────────────────────
#  5. MAIL GOSTU — dvije mogućnosti, biraš JEDNU
# ───────────────────────────────────────────────────────────────────────────
#
#  Bez ovoga sajt i dalje prima rezervacije, ali gost ne dobija nikakvu
#  potvrdu na mejl. Ti ćeš ih vidjeti u panelu (i na Telegramu, grupa 6).
#
#  ── MOGUĆNOST A: Gmail ────────────────────────────────────────────────────
#  Najbrže za početak. Šalje s tvoje obične Gmail adrese i može pisati BILO
#  KOME odmah. Ako imaš Gmail, počni ovim.
#
#  Ako je popunjen Gmail, on ima prednost i Resend se ignoriše.

# Tvoja Gmail adresa, npr. ime.prezime@gmail.com
GMAIL_USER=

#  ⚠️  OVO NIJE LOZINKA KOJOM SE PRIJAVLJUJEŠ NA GOOGLE.
#
#  Ovo je zasebna "lozinka za aplikacije" od 16 slova. Postoji tek kad je na
#  nalogu uključena dvostruka provjera (2FA), i može se poništiti bez diranja
#  same lozinke naloga.
#
#  GDJE SE NALAZI:
#  myaccount.google.com → Security → uključi "2-Step Verification" ako nije
#  → pa u pretragu na vrhu upiši "App passwords" → napravi novu, nazovi je
#  npr. "TreeScape" → Google ti pokaže 16 slova u četiri grupe.
#  Upisuješ ih BEZ razmaka.
GMAIL_APP_PASSWORD=

#  ── MOGUĆNOST B: Resend ───────────────────────────────────────────────────
#  Za kasnije, kad kuća dobije svoj domen — pa mailovi kreću s
#  rezervacije@treescape.ba umjesto s lične Gmail adrese. Izgleda ozbiljnije.
#
#  KVAKA: dok ne potvrdiš vlasništvo nad domenom, Resend šalje SAMO na adresu
#  s kojom si otvorio nalog. Pravom gostu se ne može pisati. Zato Gmail za
#  početak.
#
#  GDJE SE NALAZI:
#  resend.com → uloguj se → lijevi meni "API Keys" → "Create API Key"
#  → ime bilo koje, Permission: "Sending access" → kopiraj ključ ODMAH,
#  pokazuje se samo jednom. Počinje sa "re_".
RESEND_API_KEY=

# Adresa s koje mail stiže gostu. Mora biti na domenu koji si potvrdio u
# Resendu (resend.com → Domains → Add Domain, pa upišeš DNS zapise koje ti
# oni daju). Format s imenom u zagradi:
#   TreeScape <rezervacije@treescape.ba>
# Ako ostaviš prazno, koristi se Resendova probna adresa.
EMAIL_FROM=

# Tvoja adresa — na nju stiže kopija svakog novog zahtjeva. Ovo je adresa na
# koju TI primaš obavijesti, nije ona s koje se šalje gostu.
OWNER_EMAIL=


# ───────────────────────────────────────────────────────────────────────────
#  6. OBAVIJEST NA TELEFON — Telegram
# ───────────────────────────────────────────────────────────────────────────
#
#  Stoji UZ mail, ne umjesto njega. Razlog je praktičan: zahtjev za plaćanje u
#  gotovini vrijedi samo dok se termin drži, a mail zna završiti u promocijama
#  i biti pročitan sutradan. Telegram stigne za koju sekundu i besplatan je.
#
#  GDJE SE NALAZI — dva koraka, oba u samom Telegramu:
#
#  KORAK 1 — napravi bota:
#    U Telegramu potraži korisnika  @BotFather  → pošalji mu  /newbot
#    → daj ime bota i korisničko ime (mora završavati na "bot")
#    → on ti odgovori porukom u kojoj piše token oblika
#      123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#    To je TELEGRAM_BOT_TOKEN.
#
#  KORAK 2 — nađi svoj chat id:
#    Nađi svog novog bota u Telegramu i pošalji mu bilo šta (npr. "zdravo").
#    Bez ovog koraka ne radi — bot ne smije prvi pisati nepoznatom.
#    Zatim otvori u pregledniku:
#      https://api.telegram.org/bot<TOKEN>/getUpdates
#    (umjesto <TOKEN> zalijepi token iz koraka 1)
#    U odgovoru potraži  "chat":{"id":123456789  — taj broj je chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ───────────────────────────────────────────────────────────────────────────
#  7. TEST NAČIN PLAĆANJA
# ───────────────────────────────────────────────────────────────────────────
#
#  Dodaje u obrazac treću opciju koja potvrdi rezervaciju bez ijednog pravog
#  centa — da možeš proći cijeli tok od kraja do kraja.
#
#  NA PRODUKCIJI OSTAVI PRAZNO ILI "false". Gostima se ne prikazuje samo dok
#  je ovo isključeno.
ENABLE_TEST_PAYMENTS=false


# ═══════════════════════════════════════════════════════════════════════════
#  PROVJERA DA JE SVE DOBRO
# ═══════════════════════════════════════════════════════════════════════════
#
#    npm run doctor     — prolazi kroz sve varijable i kaže šta fali i zašto
#    npm run db:check   — javlja da li se baza javlja i da li tabele postoje
#
#  Isto ti pokazuje i sam panel nakon prijave.
# ═══════════════════════════════════════════════════════════════════════════
